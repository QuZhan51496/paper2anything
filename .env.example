# paper2anything 统一凭据配置（5 个 skill 共用）
# ──────────────────────────────────────────────────────────
# 用法：
#   1) 复制为 .env：   cp .env.example .env
#   2) 填入你自己的 key（.env 应 gitignore，切勿提交）
#   3) 每个新 shell 运行 skill 前，导出一次到环境变量：
#         set -a; source <paper2anything 包根>/.env; set +a
#      （或把这一行写进 ~/.bashrc 一劳永逸）
# 之后所有 `conda run -n paper2anything ... python ...` 都能读到这些值。
# 5 个 skill 的脚本最终都从 os.environ 读取，无需各自的局部配置文件。
# 按需填写——不用的 skill 对应的 key 可留空。
# ──────────────────────────────────────────────────────────

# ── PDF 解析：MinerU 云端 API ──（在 https://mineru.net 申请）
# 5 个 skill 统一用 MINERU_API_TOKEN。（未发表/敏感论文走 slides 的 `--backend local` 时不需要。）
MINERU_API_TOKEN=your-mineru-token
# MINERU_API_BASE 是 API 端点根（主机部分），slides/html/poster 各自拼接 /api/v4；
# 一般无需改，除非走自建镜像/代理。务必填主机根，勿写成 .../api/v4。
MINERU_API_BASE=https://mineru.net

# ── Anthropic ──（paper2xhs / paper2wechat 的 Stage 3/4/5）
# 用第三方代理时把 BASE_URL 改成代理地址即可。
ANTHROPIC_API_KEY=your-anthropic-or-proxy-key
ANTHROPIC_BASE_URL=https://api.anthropic.com
# 可选：覆盖默认 Claude 模型（xhs/wechat 共用，默认值即下方注释）。
# CLAUDE_MODEL=claude-sonnet-4-6                 # 主力（理解/结构化/生成）
# CLAUDE_FAST_MODEL=claude-haiku-4-5-20251001    # 廉价快速（xhs Stage 3 首轮）

# ── OpenAI ──（paper2html 的 LLM 渲染；paper2xhs / paper2wechat 的封面生成）
# paper2html 把 OPENAI_API_KEY 当作 LLM 网关 key（配合下方 LLM_BASE_URL/LLM_MODEL）。
OPENAI_API_KEY=your-openai-or-proxy-key
OPENAI_BASE_URL=https://api.openai.com/v1
# 可选：覆盖封面生成的图像模型（xhs/wechat 共用，默认 gpt-image-1）。
# OPENAI_IMAGE_MODEL=gpt-image-1

# ── paper2html LLM 网关 ──（OpenAI 或 Anthropic 兼容；缺省自动识别网关类型）
LLM_BASE_URL=http://model.mify.ai.srv/v1
LLM_MODEL=azure_openai/gpt-5.4
LLM_REQUEST_TIMEOUT=900

# ── paper2poster VLM ──（DashScope / Qwen3-VL）
# poster 同时认 DASHSCOPE_API_KEY 与 API_KEY（填同值即可）。
DASHSCOPE_API_KEY=your-dashscope-key
API_KEY=your-dashscope-key
API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_MODEL=qwen3-vl-plus
# 可选：覆盖 poster 文本模型（翻译 / PaperQuiz 出题，默认 qwen-plus）。
# POSTER_TEXT_MODEL=qwen-plus
# 可选开关：图选择器 VLM（默认 1 开）、绕过 figure gate（文本型论文）
# PAPER2POSTER_VLM_FIGURE_SELECT=1
# PAPER2POSTER_ALLOW_NO_SELECTION=1

# ── paper2wechat 公众号 & md2wechat ──（Stage 7）
WECHAT_APPID=your-wechat-app-id
WECHAT_APP_SECRET=your-wechat-app-secret
MD2WECHAT_THEME=default
# md2wechat 不在 PATH 时填完整路径：
# MD2WECHAT_CMD=md2wechat

# ── paper2xhs 发布（可选）──
# 克隆 https://github.com/autoclaw-cc/xiaohongshu-skills 后填入目录：
# XHS_SKILLS_DIR=/path/to/xiaohongshu-skills
