# paper2anything 统一凭据配置（5 个 skill 共用）
# ──────────────────────────────────────────────────────────
# 用法：
#   1) 复制为 .env：   cp .env.example .env
#   2) 填入你自己的 key（.env 应 gitignore，切勿提交）
#   3) 推荐：把下面这行写进 shell 启动文件（Linux/bash→~/.bashrc，macOS/zsh→~/.zshrc），
#      每个新 shell 自动加载、对所有进程可见（也可跑 tools/install-linux.sh / install-macos.sh --shell-init 自动写入）：
#         set -a; source <paper2anything 包根>/.env; set +a
#      （脚本内已 load_dotenv 兜底，即使不导出也能跑；已 export 的环境变量优先于 .env）
# 之后所有 `conda run -n paper2anything ... python ...` 都能读到这些值。
# 5 个 skill 的脚本最终都从 os.environ 读取，无需各自的局部配置文件。
# 按需填写——不用的 skill 对应的 key 可留空。
# ──────────────────────────────────────────────────────────

# ── PDF 解析：MinerU 云端 API ──（在 https://mineru.net 申请）
# 5 个 skill 统一用 MINERU_API_TOKEN（必填）。
MINERU_API_TOKEN=your-mineru-token
# MINERU_API_BASE 是 API 端点根（主机部分），5 个 skill 各自拼接 /api/v4；
# 一般无需改，除非走自建镜像/代理。务必填主机根，勿写成 .../api/v4。
MINERU_API_BASE=https://mineru.net

# ── OpenAI ──（仅 paper2xhs / paper2wechat 的封面 AI 生成；可选）
# xhs/wechat 的 cover.py 默认用它生成封面；留空则回退本地合成（复用论文原图）。
OPENAI_API_KEY=your-openai-or-proxy-key
OPENAI_BASE_URL=https://api.openai.com/v1
# 可选：覆盖封面生成的图像模型（xhs/wechat 共用，默认 gpt-image-2）。
# OPENAI_IMAGE_MODEL=gpt-image-2

# ── paper2wechat md2wechat 排版/草稿箱 ──（可选）
# WECHAT_APPID / WECHAT_APP_SECRET：md2wechat 推送公众号草稿箱时由其自身读取（不上传可留空）。
WECHAT_APPID=your-wechat-app-id
WECHAT_APP_SECRET=your-wechat-app-secret
MD2WECHAT_THEME=default
# md2wechat 不在 PATH 时填完整路径：
# MD2WECHAT_CMD=md2wechat

# ── paper2xhs 发布（可选）──
# 发布走开源项目 xiaohongshu-mcp（https://github.com/xpzouying/xiaohongshu-mcp）。
# 一般无需手动设——skill 执行到发布时会自动检查二进制、不存在则按平台下载到 ~/.paper2anything/xhs/。
# 只在想用自定义二进制位置/版本时才设（登录-发布详见 paper2xhs/references/publish-guide.md）：
# XHS_MCP_BIN=/path/to/xiaohongshu-mcp-linux-amd64
# 自定义 mcp 服务地址/端口（默认 http://localhost:18060）：
# XHS_MCP_URL=http://localhost:18060
